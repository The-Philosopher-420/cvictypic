// Cvič ty pič – vstavaný server (Google Apps Script, web app „Anyone“). Úložisko = ScriptProperties (gzip + base64 po 8000 znakoch).
// API: POST text/plain JSON {key,op,...}: ping | list{dir} | get{path} | getmany{paths} | put{path,text,sha} | bulk{files:[{path,text}],force}
// Každý riadok = jedna funkcia (editor Apps Scriptu dopĺňa zátvorky pri Enter – preto jednoriadkové funkcie).
var KEY='ctp-2026';
function out_(o){ return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON); }
function sha_(t){ return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_1,t,Utilities.Charset.UTF_8).map(function(b){ b=(b+256)%256; return ('0'+b.toString(16)).slice(-2); }).join(''); }
function store_(){ var p=PropertiesService.getScriptProperties(); var n=parseInt(p.getProperty('n')||'0',10); if(!n){ return {}; } var s=''; for(var i=0;i<n;i++){ s+=p.getProperty('c'+i)||''; } try{ return JSON.parse(Utilities.ungzip(Utilities.newBlob(Utilities.base64Decode(s),'application/x-gzip')).getDataAsString()); }catch(e){ return {}; } }
function save_(m){ var s=Utilities.base64Encode(Utilities.gzip(Utilities.newBlob(JSON.stringify(m))).getBytes()); var p=PropertiesService.getScriptProperties(); var old=parseInt(p.getProperty('n')||'0',10); var obj={}; var n=0; for(var i=0;i<s.length;i+=8000){ obj['c'+n]=s.substr(i,8000); n++; } obj.n=String(n); p.setProperties(obj,false); for(var j=n;j<old;j++){ p.deleteProperty('c'+j); } return n; }
function list_(m,dir){ if(dir.slice(-1)!=='/'){ dir+='/'; } var out=[]; for(var k in m){ if(k.indexOf(dir)===0&&k.slice(dir.length).indexOf('/')<0){ out.push({name:k.slice(dir.length),sha:m[k].s}); } } return {files:out}; }
function put_(req){ var lock=LockService.getScriptLock(); lock.waitLock(20000); try{ var m=store_(); var cur=m[req.path]; if(cur&&req.sha!==cur.s){ return {conflict:true}; } if(!cur&&req.sha){ return {conflict:true}; } var sha=sha_(req.text); m[req.path]={s:sha,t:req.text,u:Date.now()}; save_(m); return {sha:sha}; }finally{ lock.releaseLock(); } }
function bulk_(req){ var lock=LockService.getScriptLock(); lock.waitLock(20000); try{ var m=store_(); var n=0; (req.files||[]).forEach(function(f){ if(f&&f.path&&typeof f.text==='string'&&(!m[f.path]||req.force)){ m[f.path]={s:sha_(f.text),t:f.text,u:Date.now()}; n++; } }); var chunks=save_(m); return {ok:true,added:n,total:Object.keys(m).length,chunks:chunks}; }finally{ lock.releaseLock(); } }
function handle_(req){ if(!req||req.key!==KEY){ return {error:'bad key'}; } var op=req.op; if(op==='ping'){ return {ok:true,t:Date.now()}; } if(op==='put'){ return put_(req); } if(op==='bulk'){ return bulk_(req); } var m=store_(); if(op==='list'){ return list_(m,String(req.dir||'')); } if(op==='get'){ var r=m[req.path]; return r?{sha:r.s,text:r.t}:{missing:true}; } if(op==='getmany'){ var o={}; (req.paths||[]).forEach(function(q){ var x=m[q]; if(x){ o[q]={sha:x.s,text:x.t}; } }); return {items:o}; } if(op==='count'){ return {total:Object.keys(m).length}; } return {error:'bad op'}; }
function doPost(e){ var req={}; try{ req=JSON.parse(e.postData.contents); }catch(err){ req={}; } return out_(handle_(req)); }
function doGet(e){ var req={}; try{ req=JSON.parse((e.parameter&&e.parameter.q)||'{}'); }catch(err){ req={}; } if(e.parameter&&e.parameter.op){ req.op=e.parameter.op; req.key=e.parameter.key; req.dir=e.parameter.dir; req.path=e.parameter.path; } return out_(handle_(req)); }
